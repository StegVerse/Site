{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/minimality-evaluator-response.schema.json",
  "title": "Minimality Evaluator Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "fixture_id",
    "fixture_sha256",
    "evaluator_reference",
    "execution_class",
    "canonical_record_hidden_during_evaluation",
    "removed_element_hidden_during_evaluation",
    "answers",
    "inherited_limitations",
    "new_failures",
    "assumptions_used",
    "classification",
    "rationale",
    "independently_reproduced"
  ],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluator_reference": {"type": "string", "minLength": 1},
    "execution_class": {
      "enum": ["INTERNAL_EXECUTION", "EXTERNAL_EXECUTION", "INDEPENDENT_REPRODUCTION"]
    },
    "canonical_record_hidden_during_evaluation": {"type": "boolean"},
    "removed_element_hidden_during_evaluation": {"type": "boolean"},
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_identifiable",
        "recommendation_identifiable",
        "reasoning_explainable",
        "criteria_and_constraints_identifiable",
        "uncertainty_identifiable",
        "boundary_separation_preserved",
        "downstream_evaluation_independent",
        "provenance_attributable",
        "new_ambiguity_introduced",
        "ungrounded_assumption_required"
      ],
      "properties": {
        "intent_identifiable": {"enum": ["YES", "PARTIAL", "NO"]},
        "recommendation_identifiable": {"enum": ["YES", "PARTIAL", "NO"]},
        "reasoning_explainable": {"enum": ["YES", "PARTIAL", "NO"]},
        "criteria_and_constraints_identifiable": {"enum": ["YES", "PARTIAL", "NO"]},
        "uncertainty_identifiable": {"enum": ["YES", "PARTIAL", "NO"]},
        "boundary_separation_preserved": {"enum": ["YES", "PARTIAL", "NO"]},
        "downstream_evaluation_independent": {"enum": ["YES", "PARTIAL", "NO"]},
        "provenance_attributable": {"enum": ["YES", "PARTIAL", "NO"]},
        "new_ambiguity_introduced": {"type": "boolean"},
        "ungrounded_assumption_required": {"type": "boolean"}
      }
    },
    "inherited_limitations": {"type": "array", "items": {"type": "string"}},
    "new_failures": {"type": "array", "items": {"type": "string"}},
    "assumptions_used": {"type": "array", "items": {"type": "string"}},
    "classification": {
      "enum": ["REQUIRED", "CONDITIONALLY_REQUIRED", "REDUNDANT", "OPTIONAL", "UNDETERMINED"]
    },
    "condition": {"type": ["string", "null"]},
    "rationale": {"type": "string", "minLength": 1},
    "independently_reproduced": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "CONDITIONALLY_REQUIRED"}}},
      "then": {"required": ["condition"], "properties": {"condition": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"execution_class": {"const": "INTERNAL_EXECUTION"}}},
      "then": {"properties": {"independently_reproduced": {"const": false}}}
    },
    {
      "if": {"properties": {"independently_reproduced": {"const": true}}},
      "then": {"properties": {"execution_class": {"const": "INDEPENDENT_REPRODUCTION"}}}
    }
  ]
}
